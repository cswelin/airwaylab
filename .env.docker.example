# AirwayLab — self-hosted docker-compose environment
# Copy to .env (same directory as docker-compose.yml) and fill in.
#
# Setup order:
#   1. cp .env.docker.example .env
#   2. Fill in the app + URL sections below.
#   3. sh scripts/supabase/generate-keys.sh --update-env
#      (generates POSTGRES_PASSWORD, JWT_SECRET, ANON_KEY, SERVICE_ROLE_KEY,
#      DASHBOARD_PASSWORD, and a few other secrets — overwrites the
#      placeholder values below directly in .env)
#   4. Fill in SMTP settings if you want magic-link emails to actually send —
#      self-hosted Auth has no default mailer, unlike Supabase Cloud.
#   5. docker compose up -d --build

############
# App
############

# Host port for the Next.js app container
HOST_PORT=3000

# Externally reachable URL for the app itself (used for CSRF checks + auth
# redirect links). Must match how you actually access the app.
NEXT_PUBLIC_APP_URL=http://your-server-ip:3000

# Anthropic API key for AI Insights (Claude Haiku/Sonnet). Server-only —
# read at runtime via env_file, not a NEXT_PUBLIC_* build arg. Optional:
# leave blank to run without the AI Insights feature (rest of the app works).
ANTHROPIC_API_KEY=sk-ant-...


############
# Supabase — Postgres
############

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
# Generated by scripts/supabase/generate-keys.sh
POSTGRES_PASSWORD=


############
# Supabase — secrets (generate with scripts/supabase/generate-keys.sh)
############

JWT_SECRET=
JWT_EXPIRY=3600
ANON_KEY=
SERVICE_ROLE_KEY=

# Studio dashboard login (served at SUPABASE_PUBLIC_URL, basic auth via Kong)
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=

PG_META_CRYPTO_KEY=


############
# Supabase — URLs
############

# Externally reachable URL for the Supabase API gateway (Kong). The browser
# talks to this directly (magic-link sign-in, file uploads), so it must be
# reachable from wherever you load the app — not a Docker-internal hostname.
SUPABASE_PUBLIC_URL=http://your-server-ip:8000
KONG_HTTP_PORT=8000

API_EXTERNAL_URL=http://your-server-ip:8000/auth/v1


############
# Supabase — Auth (GoTrue)
############

SITE_URL=http://your-server-ip:3000
# Wildcard covers /auth/callback plus any ?next= query param
ADDITIONAL_REDIRECT_URLS=http://your-server-ip:3000/**

DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

# Self-hosted Auth has NO default mailer — magic-link emails will not send
# until these point at a real SMTP provider (Resend, SES, Mailgun, your own
# mail server, a Gmail app password, etc.).
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=AirwayLab


############
# Supabase — REST (PostgREST)
############

PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public


############
# Supabase — Storage
############

GLOBAL_S3_BUCKET=stub
REGION=stub
STORAGE_TENANT_ID=stub


############
# Supabase — Studio
############

STUDIO_DEFAULT_ORGANIZATION=AirwayLab
STUDIO_DEFAULT_PROJECT=AirwayLab
